@model WebApplication1.Models.Warehouse
@{
    ViewData["Title"] = "Edit warehouse";
}
<div class="page-heading"><div><h1>Edit warehouse</h1><p>Update the storage location name.</p></div></div>
<form asp-action="Edit" method="post" class="form-card">
    <input type="hidden" asp-for="WarehouseId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Warehouse name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
