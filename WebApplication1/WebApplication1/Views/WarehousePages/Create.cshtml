@model WebApplication1.Models.Warehouse
@{
    ViewData["Title"] = "New warehouse";
}
<div class="page-heading"><div><h1>Add warehouse</h1><p>Create a storage location for your stock.</p></div></div>
<form asp-action="Create" method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Warehouse name</label>
        <input asp-for="Name" class="form-control" placeholder="e.g. Main warehouse" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Create warehouse</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
