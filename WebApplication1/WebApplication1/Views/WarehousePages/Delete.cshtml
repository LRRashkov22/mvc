@model WebApplication1.Models.Warehouse
@{
    ViewData["Title"] = "Delete warehouse";
}
<div class="page-heading"><div><h1>Delete warehouse</h1><p>Confirm the storage location you want to remove.</p></div></div>
<div class="form-card">
    <p>Delete warehouse <strong>@Model.Name</strong>?</p>
    <p class="muted">A warehouse with inventory or delivery records cannot be deleted.</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.WarehouseId" />
        <div class="form-actions">
            <button type="submit" class="btn btn-danger">Delete warehouse</button>
            <a asp-action="Index" class="btn btn-light">Cancel</a>
        </div>
    </form>
</div>
