<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Stockroom</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">S</span><span>stockroom<small>INVENTORY CONTROL</small></span></a>
        <div class="nav-label">WORKSPACE</div>
        <nav class="side-nav">
            <a asp-controller="Home" asp-action="Index"><span>◫</span> Overview</a>
            <a asp-controller="Categories" asp-action="Index"><span>▤</span> Categories</a>
            <a asp-controller="WarehousePages" asp-action="Index"><span>⌂</span> Warehouses</a>
            <a asp-controller="ProductPages" asp-action="Index"><span>◇</span> Products</a>
            <a asp-controller="InventoryPages" asp-action="Index"><span>▦</span> Inventory</a>
            <a asp-controller="Deliveries" asp-action="Index"><span>↙</span> Deliveries</a>
        </nav>
        <div class="sidebar-bottom"><span class="status-dot"></span> System workspace <small>Warehouse management</small></div>
    </aside>
    <main class="main-area">
        <header class="topbar">
            <div><span class="eyebrow">WAREHOUSE MANAGEMENT</span><div class="topbar-title">@ViewData["Title"]</div></div>
            <div class="d-flex align-items-center gap-3">
                <span class="small text-muted">@User.Identity?.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-light btn-sm">Sign out</button>
                </form>
            </div>
        </header>
        <section class="page-content">
            @if (TempData["Error"] is string error) { <div class="alert alert-warning">@error</div> }
            @RenderBody()
        </section>
        <footer class="app-footer">Stockroom <span>·</span> Inventory management system</footer>
    </main>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
