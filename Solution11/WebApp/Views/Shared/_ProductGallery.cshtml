@model WebApplication1.Models.Product
@{
    var returnUrl = Url.Action("Edit", new { id = Model.ProductId });
    var images = Model.Images.OrderBy(i => i.UploadedAtUtc).ToList();
}
<div class="form-card" style="margin-top:1.5rem">
    <h2 class="h5">Product images</h2>
    <p class="muted">JPG, PNG or WebP, up to 5 MB each. Images are resized and compressed automatically.</p>

    @if (TempData["ImageSuccess"] is string okMessage)
    {
        <div class="alert alert-success">@okMessage</div>
    }
    @if (TempData["ImageError"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (images.Count == 0)
    {
        <p class="muted">No images yet.</p>
    }
    else
    {
        <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:1rem">
            @foreach (var img in images)
            {
                <div style="text-align:center">
                    <a href="@Url.Action("Media", "ProductImages", new { productId = img.ProductId, fileName = img.FileName })" target="_blank" rel="noopener">
                        <img src="@Url.Action("Media", "ProductImages", new { productId = img.ProductId, fileName = img.ThumbFileName })"
                             alt="@img.OriginalFileName" loading="lazy"
                             style="max-width:160px;max-height:160px;border-radius:8px;display:block" />
                    </a>
                    <form asp-controller="ProductImages" asp-action="Delete"
                          asp-route-productId="@img.ProductId" asp-route-imageId="@img.ProductImageId" method="post">
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button class="btn btn-light btn-sm" type="submit" style="margin-top:.25rem">Remove</button>
                    </form>
                </div>
            }
        </div>
    }

    <form asp-controller="ProductImages" asp-action="Upload" asp-route-productId="@Model.ProductId"
          method="post" enctype="multipart/form-data">
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <input class="form-control" type="file" name="files" multiple required
               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" style="margin-bottom:.5rem" />
        <button class="btn btn-primary" type="submit">Upload</button>
    </form>
</div>
