@model IEnumerable<WebApplication1.Models.InventoryItem>
@{ ViewData["Title"] = "Inventory"; }
<div class="page-heading"><div><h1>Inventory</h1><p>Monitor stock levels by product and warehouse.</p></div><a class="btn btn-primary" asp-action="Create">＋ Add stock record</a></div>
<form class="filter-bar" method="get"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search product..."/><select class="form-select" name="warehouseId" asp-items="ViewBag.Warehouses"><option value="">All warehouses</option></select><button class="btn btn-primary" type="submit">Filter</button><a class="btn btn-light" asp-action="Index">Reset</a></form>
<div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Product</th><th>Warehouse</th><th>Category</th><th>Available</th><th>Quick adjust</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td class="primary-text">@(item.Product?.Name ?? $"Product #{item.ProductId}")<div class="section-subtitle">SKU #@item.ProductId</div></td><td>@(item.Warehouse?.Name ?? $"Warehouse #{item.WarehouseId}")</td><td>@(item.Product?.Category?.Name ?? "—")</td><td><span class="pill @(item.Quantity <= 5 ? "pill-warning" : "")">@item.Quantity units</span></td><td><form asp-action="Adjust" method="post" class="d-flex align-items-center gap-1"><input type="hidden" name="productId" value="@item.ProductId"/><input type="hidden" name="warehouseId" value="@item.WarehouseId"/><input class="form-control form-control-sm" type="number" name="delta" value="1" style="width:72px" aria-label="Quantity adjustment"/><button class="btn btn-light btn-sm" type="submit">Apply</button></form></td><td><a class="btn btn-light btn-sm" asp-action="Edit" asp-route-productId="@item.ProductId" asp-route-warehouseId="@item.WarehouseId">Edit</a></td></tr> }
@if (!Model.Any()) { <tr><td colspan="6"><div class="empty-state"><strong>No stock records found</strong>Add a record to start tracking inventory.</div></td></tr> }
</tbody></table></div></div>
