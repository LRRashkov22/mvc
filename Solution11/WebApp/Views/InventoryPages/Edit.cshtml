@model WebApplication1.Models.InventoryItem
@{ ViewData["Title"] = "Edit stock"; var heading = "Update stock"; var action = "Edit"; var submitText = "Save quantity"; }
<div class="page-heading"><div><h1>@heading</h1><p>Set the product, warehouse and available quantity.</p></div></div>
<form asp-action="@action" method="post" class="form-card"><div asp-validation-summary="ModelOnly"></div>
@if (Model.ProductId != 0 || Model.WarehouseId != 0) { <input type="hidden" name="productId" value="@Model.ProductId"/><input type="hidden" name="warehouseId" value="@Model.WarehouseId"/> }
<div class="mb-3"><label class="form-label" for="ProductId">Product</label><select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select" disabled="@(Model.ProductId != 0 && ViewData["Title"] == "Edit stock")"><option value="">Select product</option></select><span asp-validation-for="ProductId" class="field-validation-error"></span></div>
<div class="mb-3"><label class="form-label" for="WarehouseId">Warehouse</label><select asp-for="WarehouseId" asp-items="ViewBag.Warehouses" class="form-select" disabled="@(Model.WarehouseId != 0 && ViewData["Title"] == "Edit stock")"><option value="">Select warehouse</option></select><span asp-validation-for="WarehouseId" class="field-validation-error"></span></div>
<div class="mb-3"><label asp-for="Quantity" class="form-label">Quantity</label><input asp-for="Quantity" type="number" min="0" class="form-control"/><span asp-validation-for="Quantity" class="field-validation-error"></span></div>
<div class="form-actions"><button type="submit" class="btn btn-primary">@submitText</button><a asp-action="Index" class="btn btn-light">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
