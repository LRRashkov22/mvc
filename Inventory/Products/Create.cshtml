@model WarehouseInventoryMvc.Models.Product
@{ ViewData["Title"] = "Нов продукт"; }
<h1>Нов продукт</h1>
<form asp-controller="Inventory" asp-action="CreateProduct" method="post" class="form">
    <label asp-for="Name">Име</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name"></span>

    <label asp-for="Price">Цена</label>
    <input asp-for="Price" type="number" step="0.01" min="0" />
    <span asp-validation-for="Price"></span>

    <label asp-for="CategoryId">Категория</label>
    <select asp-for="CategoryId" asp-items="ViewBag.CategoryId">
        <option value="">-- Избери --</option>
    </select>
    <button class="button" type="submit">Запази</button>
</form>
