@using WarehouseInventoryMvc.Models
@{
    ViewData["Title"] = "Табло";
}

<section class="hero">
    <div>
        <small>УПРАВЛЕНИЕ НА СКЛАД</small>
        <h1>Складов инвентар</h1>
        <p>Преглед на продукти и наличности.</p>
    </div>
    <a class="button" asp-controller="Inventory" asp-action="CreateProduct">+ Нов продукт</a>
</section>

<section class="stats">
    <div><span>Продукти</span><strong>@ViewBag.Products</strong></div>
    <div><span>Категории</span><strong>@ViewBag.Categories</strong></div>
    <div><span>Складове</span><strong>@ViewBag.Warehouses</strong></div>
    <div><span>Налични бройки</span><strong>@ViewBag.Units</strong></div>
</section>

<h2>Наличности</h2>
<table>
    <thead><tr><th>Продукт</th><th>Склад</th><th>Количество</th></tr></thead>
    <tbody>
    @foreach (InventoryItem item in (IEnumerable<InventoryItem>)ViewBag.Stock)
    {
        <tr>
            <td>@item.Product?.Name</td>
            <td>@item.Warehouse?.Name</td>
            <td>@item.Quantity</td>
        </tr>
    }
    </tbody>
</table>
