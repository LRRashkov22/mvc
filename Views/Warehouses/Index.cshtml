@model IEnumerable<WarehouseInventoryMvc.Models.Warehouse>
@{ ViewData["Title"] = "Складове"; }
<div class="heading">
    <h1>Складове</h1>
    <a class="button" asp-controller="Inventory" asp-action="CreateWarehouse">+ Добави</a>
</div>
<table>
    <thead><tr><th>ID</th><th>Име</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr><td>@item.WarehouseId</td><td>@item.Name</td></tr>
    }
    </tbody>
</table>
