@model IEnumerable<WarehouseInventoryMvc.Models.InventoryItem>
@{ ViewData["Title"] = "Наличности"; }
<div class="heading">
    <h1>Наличности</h1>
    <a class="button" asp-controller="Inventory" asp-action="CreateStock">+ Добави</a>
</div>
<table>
    <thead><tr><th>Продукт</th><th>Склад</th><th>Количество</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr><td>@item.Product?.Name</td><td>@item.Warehouse?.Name</td><td>@item.Quantity</td></tr>
    }
    </tbody>
</table>
