@model WarehouseInventoryMvc.Models.Delivery
@{ ViewData["Title"] = "Нова доставка"; }
<h1>Нова доставка</h1>
<form asp-controller="Inventory" asp-action="CreateDelivery" method="post" class="form">
    <label asp-for="ProductId">Продукт</label>
    <select asp-for="ProductId" asp-items="ViewBag.ProductId"></select>

    <label asp-for="WarehouseId">Склад</label>
    <select asp-for="WarehouseId" asp-items="ViewBag.WarehouseId"></select>

    <label asp-for="Quantity">Количество</label>
    <input asp-for="Quantity" type="number" min="1" />
    <span asp-validation-for="Quantity"></span>

    <label asp-for="DeliveryDate">Дата</label>
    <input asp-for="DeliveryDate" type="date" />

    <button class="button" type="submit">Запази</button>
</form>
