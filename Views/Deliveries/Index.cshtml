@model IEnumerable<WarehouseInventoryMvc.Models.Delivery>
@{ ViewData["Title"] = "Доставки"; }
<div class="heading">
    <h1>Доставки</h1>
    <a class="button" asp-controller="Inventory" asp-action="CreateDelivery">+ Добави</a>
</div>
<table>
    <thead><tr><th>ID</th><th>Продукт</th><th>Склад</th><th>Количество</th><th>Дата</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.DeliveryId</td>
            <td>@item.Product?.Name</td>
            <td>@item.Warehouse?.Name</td>
            <td>@item.Quantity</td>
            <td>@item.DeliveryDate.ToString("dd.MM.yyyy")</td>
        </tr>
    }
    </tbody>
</table>
